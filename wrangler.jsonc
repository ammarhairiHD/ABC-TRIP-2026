{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himalaya-gallery",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Production: only the custom domain is a public address. workers.dev and
  // the per-version preview URLs are off so there's no second URL floating
  // around unprotected by Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "abctrip2026.ammarhairi.tech", "custom_domain": true }],

  "vars": {
    "MEDIA_BASE_URL": "https://abctrip2026-media.ammarhairi.tech"
  },

  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/i18n/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "himalaya",
      "database_id": "ccdacd9a-0a6f-4a39-b20f-c2228044a1a3",
      "migrations_dir": "api/migrations"
    }
  ],

  "r2_buckets": [
    // remote: true -- wrangler dev proxies this binding to the real,
    // deployed himalaya-media bucket instead of simulating an empty local
    // one, so /i18n/* and media URLs show whatever publish.py --upload has
    // actually put in R2. ORIGINALS and DB stay on local simulation: no
    // need to touch the private bucket or the real D1 data in dev.
    { "binding": "MEDIA", "bucket_name": "himalaya-media" },
    { "binding": "ORIGINALS", "bucket_name": "himalaya-originals" }
  ],

  // POST /api/unlock: 5 attempts/minute per IP, enforced at the edge before
  // the Worker spends any CPU verifying a code. period must be 10 or 60.
  "ratelimits": [
    { "name": "UNLOCK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
