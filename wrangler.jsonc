{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himalaya-gallery",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "MEDIA_BASE_URL": "https://abctrip2026-media.ammarhairi.tech"
  },

  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/i18n/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "himalaya",
      "database_id": "ccdacd9a-0a6f-4a39-b20f-c2228044a1a3",
      "migrations_dir": "api/migrations"
    }
  ],

  "r2_buckets": [
    // remote: true -- wrangler dev proxies this binding to the real,
    // deployed himalaya-media bucket instead of simulating an empty local
    // one, so /i18n/* and media URLs show whatever publish.py --upload has
    // actually put in R2. ORIGINALS and DB stay on local simulation: no
    // need to touch the private bucket or the real D1 data in dev.
    { "binding": "MEDIA", "bucket_name": "himalaya-media", "remote": true },
    { "binding": "ORIGINALS", "bucket_name": "himalaya-originals" }
  ]
}
